        <mxCell id="i9e1qINNSipE0bxM-qvS-11" value="VERSIONADO" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=14;fontColor=#2F0084;" parent="1" vertex="1">
          <mxGeometry x="230" y="700" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="i9e1qINNSipE0bxM-qvS-12" value="Versionado semántico (&lt;b&gt;SemVer&lt;/b&gt;): MAYOR.MENOR.PARCHE&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Iniciando en 1.0.0, se incrementa:&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;- la versión MAYOR cuando se realiza un cambio incompatible en el API,&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;- la versión MENOR cuando se añade funcionalidad compatible con versiones anteriores, y&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;- la versión PARCHE cuando se reparan errores compatibles con versiones anteriores.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 12px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="245" y="730" width="510" height="110" as="geometry" />
        </mxCell>
        <mxCell id="i9e1qINNSipE0bxM-qvS-13" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="260" y="850" width="137.73" height="230" as="geometry" />
        </mxCell>
        <mxCell id="i9e1qINNSipE0bxM-qvS-14" value="→ cambio de funcionalidades" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=2;fontSize=10;" parent="1" vertex="1">
